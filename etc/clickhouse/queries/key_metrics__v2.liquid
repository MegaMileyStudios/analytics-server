-- Users with a persistent ID are counted by it, the others by their (daily rotating) user_id.
-- A user_id is resolved to a persistent ID if any of its sessions sent one, so it's never counted twice.
-- Persistent users are counted once per day, so both halves stay an average of daily users.
SELECT (date_diff('day', min(min), max(max)) + if(date_diff('day', min(min), max(max)) = 0, 1, 0)) AS Days,
       uniqExactIf((toDate(min), persistent_user_id), persistent_user_id IS NOT NULL) / Days AS DailyPersistentUsers,
       uniqExactIf(user_id, persistent_user_id IS NULL) / Days AS DailyInferredUsers,
       DailyPersistentUsers + DailyInferredUsers AS DailyUsers,
       uniqExact(session_id) as Sessions,
       if(isNaN(median(max - min)), 0, median(max - min)) as DurationSeconds,
       sum(count) as Events
FROM (
    SELECT min,
           max,
           user_id,
           session_id,
           count,
           max(session_persistent_user_id) OVER (PARTITION BY user_id) AS persistent_user_id
    FROM (
        SELECT min(timestamp) AS min,
               max(timestamp) AS max,
               user_id,
               session_id,
               any(persistent_user_id) AS session_persistent_user_id,
               count(*) AS count
        FROM events
        PREWHERE app_id = '{{app_id}}'
        WHERE 1 = 1
        {% if date_from and date_to %}
        AND timestamp BETWEEN '{{date_from}}' AND '{{date_to}}'
        {% endif %}
        {% if country_code %}
        AND country_code = '{{country_code}}'
        {% endif %}
        {% if event_name %}
        AND event_name = '{{event_name}}'
        {% endif %}
        {% if os_name %}
        AND os_name = '{{os_name}}'
        {% endif %}
        {% if device_model %}
        AND device_model = '{{device_model}}'
        {% endif %}
        {% if app_version %}
        AND app_version = '{{app_version}}'
        {% endif %}
        GROUP BY user_id, session_id
    )
)