-- Counts the events per period and value of one string (or boolean) property of an event.
-- Events of that name without the property are counted with Undefined = 1.
-- Periods without any events are filled in with a single row of zero events.
SELECT
    {% if granularity == 'Hour' %}
     toStartOfHour(timestamp)
    {% elsif granularity == 'Day' %}
     toStartOfDay(timestamp)
    {% else %}
     toStartOfMonth(timestamp)
    {% endif %} AS Period,
    toUInt8(NOT JSONHas(string_props, '{{prop_key}}')) AS Undefined,
    if(Undefined = 1, '', JSONExtractString(string_props, '{{prop_key}}')) AS Value,
    count() AS Events
FROM events
PREWHERE app_id = '{{app_id}}'
WHERE event_name = '{{event_name}}'
{% if date_from and date_to %}
AND timestamp BETWEEN '{{date_from}}' AND '{{date_to}}'
{% endif %}
GROUP BY Period, Undefined, Value
ORDER BY Period ASC
WITH FILL
{% if date_from and date_to %}
{% if granularity == 'Hour' %}
FROM toStartOfHour(toDateTime('{{date_from}}')) TO toStartOfHour(toDateTime('{{date_to}}'))
{% elsif granularity == 'Day' %}
FROM toStartOfDay(toDateTime('{{date_from}}')) TO toStartOfDay(toDateTime('{{date_to}}'))
{% else %}
FROM toStartOfMonth(toDateTime('{{date_from}}')) TO toStartOfMonth(toDateTime('{{date_to}}'))
{% endif %}
{% endif %}
STEP
{% if granularity == 'Hour' %}
toIntervalHour(1)
{% elsif granularity == 'Day' %}
toIntervalDay(1)
{% else %}
toIntervalMonth(1)
{% endif %}
