-- Counts events, or sessions at the time of their first event, per day of week (1 = Monday) and hour of day.
-- In local time mode (local_time) that's the player's local time, events without an offset are left out
-- and date_from/date_to are local too. Otherwise it's the viewer's time zone (viewer_tz).
{% if local_time %}{% assign ts = "(timestamp + toIntervalMinute(assumeNotNull(timezone_offset)))" %}{% else %}{% assign ts = "toTimeZone(timestamp, '" | append: viewer_tz | append: "')" %}{% endif %}
SELECT toDayOfWeek(ts) AS DayOfWeek,
       toHour(ts) AS Hour,
       count() AS Value
FROM (
    SELECT {% if metric == 'Events' %}{{ts}}{% else %}min({{ts}}){% endif %} AS ts
    FROM events
    PREWHERE app_id = '{{app_id}}'
    WHERE 1 = 1
    {% if local_time %}
    AND timezone_offset IS NOT NULL
    {% if date_from and date_to %}
    AND {{ts}} BETWEEN '{{date_from}}' AND '{{date_to}}'
    -- Real time bounds so the primary key can still be used, offsets range from -12h to +14h
    AND timestamp BETWEEN toDateTime('{{date_from}}') - INTERVAL 14 HOUR AND toDateTime('{{date_to}}') + INTERVAL 12 HOUR
    {% endif %}
    {% elsif date_from and date_to %}
    AND timestamp BETWEEN '{{date_from}}' AND '{{date_to}}'
    {% endif %}
    {% if country_code %}
    AND country_code = '{{country_code}}'
    {% endif %}
    {% if event_name %}
    AND event_name = '{{event_name}}'
    {% endif %}
    {% if os_name %}
    AND os_name = '{{os_name}}'
    {% endif %}
    {% if device_model %}
    AND device_model = '{{device_model}}'
    {% endif %}
    {% if app_version %}
    AND app_version = '{{app_version}}'
    {% endif %}
    {% if metric != 'Events' %}
    GROUP BY session_id
    {% endif %}
)
GROUP BY DayOfWeek, Hour
ORDER BY DayOfWeek, Hour
