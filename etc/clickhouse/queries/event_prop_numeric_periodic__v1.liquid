-- Aggregates one numeric property of an event per period.
-- Events without the property are skipped, Events is the number of values in the period
-- so periods without any value (filled with zeros) can be told apart from real zeros.
-- In local time mode (local_time) ts is the player's local wall-clock time, and date_from/date_to are local too.
{% assign ts = "timestamp" %}{% if local_time %}{% assign ts = "(timestamp + toIntervalMinute(assumeNotNull(timezone_offset)))" %}{% endif %}
SELECT
    {% if granularity == 'Hour' %}
     toStartOfHour(ts)
    {% elsif granularity == 'Day' %}
     toStartOfDay(ts)
    {% else %}
     toStartOfMonth(ts)
    {% endif %} AS Period,
    count() AS Events,
    min(value) AS Min,
    max(value) AS Max,
    avg(value) AS Avg,
    quantile(0.5)(value) AS Median,
    quantile(0.95)(value) AS P95,
    quantile(0.99)(value) AS P99,
    sum(value) AS Sum
FROM (
    SELECT {{ts}} AS ts,
           JSONExtractFloat(numeric_props, '{{prop_key}}') AS value
    FROM events
    PREWHERE app_id = '{{app_id}}'
    WHERE event_name = '{{event_name}}'
    AND JSONHas(numeric_props, '{{prop_key}}')
    {% if date_from and date_to %}
    AND {{ts}} BETWEEN '{{date_from}}' AND '{{date_to}}'
    {% endif %}
    {% if local_time %}
    AND timezone_offset IS NOT NULL
    {% if date_from and date_to %}
    -- Real time bounds so the primary key can still be used, offsets range from -12h to +14h
    AND timestamp BETWEEN toDateTime('{{date_from}}') - INTERVAL 14 HOUR AND toDateTime('{{date_to}}') + INTERVAL 12 HOUR
    {% endif %}
    {% endif %}
)
GROUP BY Period
ORDER BY Period ASC
WITH FILL
{% if date_from and date_to %}
{% if granularity == 'Hour' %}
FROM toStartOfHour(toDateTime('{{date_from}}')) TO toStartOfHour(toDateTime('{{date_to}}'))
{% elsif granularity == 'Day' %}
FROM toStartOfDay(toDateTime('{{date_from}}')) TO toStartOfDay(toDateTime('{{date_to}}'))
{% else %}
FROM toStartOfMonth(toDateTime('{{date_from}}')) TO toStartOfMonth(toDateTime('{{date_to}}'))
{% endif %}
{% endif %}
STEP
{% if granularity == 'Hour' %}
toIntervalHour(1)
{% elsif granularity == 'Day' %}
toIntervalDay(1)
{% else %}
toIntervalMonth(1)
{% endif %}
