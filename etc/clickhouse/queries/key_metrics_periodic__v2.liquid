-- Users with a persistent ID are counted by it, the others by their (daily rotating) user_id.
-- A user_id is resolved to a persistent ID if any of its events sent one, so it's never counted twice.
-- Month granularity averages daily users, so persistent users are counted once per day there.
SELECT
    {% if granularity == 'Hour' %}
     toStartOfHour(timestamp)
    {% elsif granularity == 'Day' %}
     toStartOfDay(timestamp)
    {% else %}
     toStartOfMonth(timestamp)
    {% endif %} AS Period,
    {% if granularity == 'Month' %}
     uniqExactIf((toDate(timestamp), persistent_user_id), persistent_user_id IS NOT NULL) / (date_diff('day', Period, toLastDayOfMonth(Period)) + 1)
    {% else %}
     uniqExactIf(persistent_user_id, persistent_user_id IS NOT NULL)
    {% endif %} AS PersistentUsers,
    {% if granularity == 'Month' %}
     uniqExactIf(user_id, persistent_user_id IS NULL) / (date_diff('day', Period, toLastDayOfMonth(Period)) + 1)
    {% else %}
     uniqExactIf(user_id, persistent_user_id IS NULL)
    {% endif %} AS InferredUsers,
    PersistentUsers + InferredUsers AS Users,
    uniqExactIf(session_id, persistent_user_id IS NOT NULL) AS PersistentSessions,
    uniqExactIf(session_id, persistent_user_id IS NULL) AS InferredSessions,
    PersistentSessions + InferredSessions AS Sessions,
    countIf(persistent_user_id IS NOT NULL) AS PersistentEvents,
    countIf(persistent_user_id IS NULL) AS InferredEvents,
    PersistentEvents + InferredEvents AS Events
FROM (
    SELECT timestamp,
           user_id,
           session_id,
           max(persistent_user_id) OVER (PARTITION BY user_id) AS persistent_user_id
    FROM events
    PREWHERE app_id = '{{app_id}}'
    WHERE 1 = 1
    {% if date_from and date_to %}
    AND timestamp BETWEEN '{{date_from}}' AND '{{date_to}}'
    {% endif %}
    {% if country_code %}
    AND country_code = '{{country_code}}'
    {% endif %}
    {% if event_name %}
    AND event_name = '{{event_name}}'
    {% endif %}
    {% if os_name %}
    AND os_name = '{{os_name}}'
    {% endif %}
    {% if device_model %}
    AND device_model = '{{device_model}}'
    {% endif %}
    {% if app_version %}
    AND app_version = '{{app_version}}'
    {% endif %}
)
GROUP by Period
ORDER BY Period ASC
WITH FILL
{% if date_from and date_to %}
{% if granularity == 'Hour' %}
FROM toStartOfHour(toDateTime('{{date_from}}')) TO toStartOfHour(toDateTime('{{date_to}}'))
{% elsif granularity == 'Day' %}
FROM toStartOfDay(toDateTime('{{date_from}}')) TO toStartOfDay(toDateTime('{{date_to}}'))
{% else %}
FROM toStartOfMonth(toDateTime('{{date_from}}')) TO toStartOfMonth(toDateTime('{{date_to}}'))
{% endif %}
{% endif %}
STEP
{% if granularity == 'Hour' %}
toIntervalHour(1)
{% elsif granularity == 'Day' %}
toIntervalDay(1) 
{% else %}
toIntervalMonth(1)
{% endif %}
