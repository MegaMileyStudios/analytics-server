-- Counts the events per value of one string (or boolean) property of an event.
-- Events of that name without the property are counted in a single row with Undefined = 1.
SELECT Undefined, Value, Events FROM (
    SELECT toUInt8(NOT JSONHas(string_props, '{{prop_key}}')) AS Undefined,
           if(Undefined = 1, '', JSONExtractString(string_props, '{{prop_key}}')) AS Value,
           count() AS Events
    FROM events
    PREWHERE app_id = '{{app_id}}'
    WHERE event_name = '{{event_name}}'
    {% if date_from and date_to %}
    AND timestamp BETWEEN '{{date_from}}' AND '{{date_to}}'
    {% endif %}
    GROUP BY Undefined, Value
)
ORDER BY Events DESC, Value ASC
